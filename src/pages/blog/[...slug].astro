---
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, formatDate, readingTime, type Post } from '../../lib/blog';

export async function getStaticPaths() {
    const posts = await getPosts();
    return posts.map((post, i) => ({
        params: { slug: post.id },
        // Posts are newest first, so the next index is the older post
        props: { post, older: posts[i + 1], newer: posts[i - 1] }
    }));
}

interface Props {
    post: Post;
    older?: Post;
    newer?: Post;
}

const { post, older, newer } = Astro.props;
const { Content } = await render(post);
const {
    title,
    description,
    pubDate,
    updatedDate,
    tags,
    draft,
    image,
    imageAlt
} = post.data;

// Structured data so Google knows this is an article, by whom and when
const postUrl = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = image
    ? new URL(
          (
              await getImage({
                  src: image,
                  format: 'jpg',
                  width: Math.min(1200, image.width)
              })
          ).src,
          Astro.site
      ).href
    : undefined;
const kate = {
    '@type': 'Person',
    name: 'Kate Mas',
    url: new URL('/about/', Astro.site).href,
    jobTitle: 'Career coach'
};
const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    author: kate,
    publisher: kate,
    mainEntityOfPage: postUrl,
    url: postUrl,
    ...(imageUrl && { image: imageUrl }),
    ...(tags.length > 0 && { keywords: tags.join(', ') }),
    inLanguage: 'en'
};
// Escape "<" so post text can never close the script tag
const jsonLdHtml = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<BaseLayout
    title={`${title} — Messy Careers`}
    description={description}
    type="article"
    publishedTime={pubDate}
    modifiedTime={updatedDate}
    noindex={draft}
    {...(image ? { image, imageAlt: imageAlt ?? title } : {})}
>
    <script
        slot="head"
        type="application/ld+json"
        is:inline
        set:html={jsonLdHtml}
    />
    <article class="py-16 sm:py-20 md:py-24 bg-background">
        <div class="container mx-auto px-5 sm:px-6">
            <div class="max-w-2xl mx-auto">
                <a href="/blog" class="link-arrow mb-10 sm:mb-12">
                    <svg
                        class="w-4 h-4"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        aria-hidden="true"
                    >
                        <path d="M19 12H5M12 19l-7-7 7-7"></path>
                    </svg>
                    All posts
                </a>

                <header class="mb-10 sm:mb-12">
                    <div
                        class="flex flex-wrap items-center gap-x-3 gap-y-2 mb-5 font-sans text-xs font-bold uppercase tracking-wider text-muted-foreground"
                    >
                        <time datetime={pubDate.toISOString()}
                            >{formatDate(pubDate)}</time
                        >
                        <span aria-hidden="true">·</span>
                        <span>{readingTime(post.body)}</span>
                        {draft && <span
                            class="bg-secondary text-primary px-2.5 py-1 rounded-full"
                        >
                            Draft
                        </span>}
                    </div>
                    <h1
                        class="font-serif text-3xl sm:text-4xl md:text-5xl text-foreground leading-tight mb-6"
                    >
                        {title}
                    </h1>
                    <p
                        class="font-sans text-lg sm:text-xl leading-relaxed text-muted-foreground"
                    >
                        {description}
                    </p>
                    {updatedDate && <p
                        class="mt-4 font-sans text-sm text-muted-foreground"
                    >
                        Updated {formatDate(updatedDate)}
                    </p>}
                    {image && (
                        <Image
                            src={image}
                            alt={imageAlt ?? ''}
                            widths={[672, 1344]}
                            sizes="(min-width: 720px) 672px, 100vw"
                            loading="eager"
                            class="mt-10 w-full h-auto rounded-2xl"
                        />
                    )}
                </header>

                <div class="blog-prose">
                    <Content />
                </div>

                {tags.length > 0 && <ul class="flex flex-wrap gap-2 mt-12">
                    {tags.map((tag) => <li
                        class="font-sans text-xs font-bold bg-secondary text-primary px-3 py-1.5 rounded-full uppercase tracking-wider"
                    >
                        {tag}
                    </li>)}
                </ul>}

                {(older || newer) && <nav
                    aria-label="More posts"
                    class="grid sm:grid-cols-2 gap-4 mt-14 sm:mt-16 pt-10 border-t border-border"
                >
                    {newer ? (
                        <a
                            href={`/blog/${newer.id}`}
                            class="block bg-card border border-border hover:border-primary transition-colors rounded-2xl p-5"
                        >
                            <span
                                class="block font-sans text-xs font-bold uppercase tracking-wider text-muted-foreground mb-2"
                            >
                                ← Newer
                            </span>
                            <span
                                class="font-sans font-bold text-foreground leading-snug"
                            >
                                {newer.data.title}
                            </span>
                        </a>
                    ) : (
                        <span class="hidden sm:block" />
                    )}
                    {older && <a
                        href={`/blog/${older.id}`}
                        class="block bg-card border border-border hover:border-primary transition-colors rounded-2xl p-5 sm:text-right"
                    >
                        <span
                            class="block font-sans text-xs font-bold uppercase tracking-wider text-muted-foreground mb-2"
                        >
                            Older →
                        </span>
                        <span
                            class="font-sans font-bold text-foreground leading-snug"
                        >
                            {older.data.title}
                        </span>
                    </a>}
                </nav>}
            </div>
        </div>
    </article>

    <!-- BLUE: CTA -->
    <section class="py-16 sm:py-20 md:py-24 bg-primary text-primary-foreground">
        <div class="container mx-auto px-5 sm:px-6">
            <div class="max-w-3xl mx-auto text-center">
                <h2
                    class="font-serif text-3xl sm:text-4xl md:text-5xl leading-tight mb-6"
                >
                    Sound familiar?
                </h2>
                <p
                    class="font-sans text-base sm:text-lg md:text-xl leading-relaxed text-primary-foreground/70 mb-8 sm:mb-10"
                >
                    You don't need a plan to book a call. Bring the mess. We'll
                    figure out what's in it.
                </p>
                <a href="/intro-call" class="btn-white btn-lg"
                    >Book a clarity call</a
                >
            </div>
        </div>
    </section>
</BaseLayout>
