---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Scribble from '../../components/Scribble.astro';
import { getPosts, formatDate, readingTime } from '../../lib/blog';

const posts = await getPosts();
---

<BaseLayout
    title="Blog — Messy Careers by Kate Mas"
    description="Honest writing on career changes, pivots, doubt and figuring out what's next, from career coach Kate Mas."
>
    <!-- BEIGE: Intro + posts -->
    <section class="py-16 sm:py-20 md:py-24 bg-background">
        <div class="container mx-auto px-5 sm:px-6">
            <div class="max-w-3xl mx-auto">
                <p
                    class="font-sans text-xs font-bold uppercase tracking-wider text-primary mb-4"
                >
                    The blog
                </p>
                <h1
                    class="font-serif text-3xl sm:text-4xl md:text-5xl text-foreground leading-tight mb-6"
                >
                    Notes from the
                    <Scribble variant="underline" delay={0.3}
                        >messy middle</Scribble
                    >
                </h1>
                <p
                    class="font-sans text-base sm:text-lg leading-relaxed text-muted-foreground mb-12 sm:mb-16"
                >
                    Writing on career changes, second-guessing, and figuring out
                    what's next when the plan stopped making sense.
                </p>

                {posts.length === 0 ? (
                    <div
                        class="bg-card border border-border rounded-2xl p-6 sm:p-8"
                    >
                        <p
                            class="font-accent text-xl sm:text-2xl text-primary leading-snug"
                        >
                            First posts are on their way.
                        </p>
                    </div>
                ) : (
                    <ul class="flex flex-col gap-4 sm:gap-6">
                        {posts.map((post) => <li>
                            <a
                                href={`/blog/${post.id}`}
                                class="group block bg-card border border-border hover:border-primary transition-colors rounded-2xl p-6 sm:p-8"
                            >
                                <div
                                    class="flex flex-wrap items-center gap-x-3 gap-y-2 mb-4 font-sans text-xs font-bold uppercase tracking-wider text-muted-foreground"
                                >
                                    <time
                                        datetime={post.data.pubDate.toISOString()}
                                    >
                                        {formatDate(post.data.pubDate)}
                                    </time>
                                    <span aria-hidden="true">·</span>
                                    <span>{readingTime(post.body)}</span>
                                    {post.data.draft && <span
                                        class="bg-secondary text-primary px-2.5 py-1 rounded-full"
                                    >
                                        Draft
                                    </span>}
                                </div>
                                <h2
                                    class="font-serif text-2xl sm:text-3xl text-foreground leading-tight mb-3"
                                >
                                    {post.data.title}
                                </h2>
                                <p
                                    class="font-sans text-base sm:text-lg leading-relaxed text-muted-foreground mb-5"
                                >
                                    {post.data.description}
                                </p>
                                <span class="link-arrow">
                                    Read the post
                                    <svg
                                        class="w-4 h-4 transition-transform group-hover:translate-x-1"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        aria-hidden="true"
                                    >
                                        <path d="M5 12h14M12 5l7 7-7 7" />
                                    </svg>
                                </span>
                            </a>
                        </li>)}
                    </ul>
                )}
            </div>
        </div>
    </section>

    <!-- BLUE: CTA -->
    <section class="py-16 sm:py-20 md:py-24 bg-primary text-primary-foreground">
        <div class="container mx-auto px-5 sm:px-6">
            <div class="max-w-3xl mx-auto text-center">
                <h2
                    class="font-serif text-3xl sm:text-4xl md:text-5xl leading-tight mb-6"
                >
                    Reading is good. Talking is better.
                </h2>
                <p
                    class="font-sans text-base sm:text-lg md:text-xl leading-relaxed text-primary-foreground/70 mb-8 sm:mb-10"
                >
                    If something here sounds a lot like your situation, let's
                    talk it through.
                </p>
                <a href="/intro-call" class="btn-white btn-lg"
                    >Book a clarity call</a
                >
            </div>
        </div>
    </section>
</BaseLayout>
