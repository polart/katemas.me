---
// ─── Links: paste the real URLs here ────────────────────────────────────────
// €29 Next Move Playbook: Stripe checkout.
const PLAYBOOK_URL = 'https://buy.stripe.com/6oUeVd8rQ3vl9Ycerg4ow00';
// €150 Bold Move Session: Stripe checkout.
// Booking link: https://cal.com/katemas/the-bold-move-session
const SESSION_URL = 'https://buy.stripe.com/3cI6oH9vU0j9gmA4QG4ow01';
// ────────────────────────────────────────────────────────────────────────────

// Same self-hosted fonts as the rest of the site (see src/styles/global.css)
import '@fontsource/dela-gothic-one';
import '@fontsource/plus-jakarta-sans/400.css';
import '@fontsource/plus-jakarta-sans/500.css';
import '@fontsource/plus-jakarta-sans/700.css';
import '@fontsource/playfair-display/400-italic.css';
import '@fontsource/playfair-display/500-italic.css';

import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import heroImg from '../assets/next-move/kate-standing.jpg';
import aboutImg from '../assets/next-move/kate-chair.jpg';

const title = 'The Next Move Playbook · Kate Mas';
const description =
    'A 90-minute worksheet for senior tech people who are applying everywhere and hearing nothing back. Stop applying everywhere. Start aiming.';

const ogImage = await getImage({ src: heroImg, format: 'jpg', width: 724 });
const ogImageUrl = new URL(ogImage.src, Astro.site).href;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

const familiar = [
    'Every role you find already has 100+ applicants by the time you see it.',
    "You've sent dozens of applications. The replies? A few automated rejections, written for a unicorn.",
    'Cold messages used to get you a recruiter screen. Now they just disappear.',
    "You know you're good. You just can't say why in one breath.",
    'Years across design, writing and product, and no idea how to package them.',
    "You're busy every day, and still feel like you're searching blind."
];

const reframe = [
    {
        num: '01',
        title: 'Direction',
        text: "You're aiming at too many things, so nothing you send is sharp."
    },
    {
        num: '02',
        title: 'Positioning',
        text: "You can't say why you in one breath, so a recruiter skimming for six seconds can't either."
    },
    {
        num: '03',
        title: 'Route',
        text: "You're coming in through the most crowded door there is: the Apply button."
    }
];

const parts = [
    {
        part: 'Part 0',
        time: '10 minutes',
        title: 'Where is it actually breaking?',
        text: 'Count your last 8 weeks honestly, from applications to replies to interviews, and find the leak before you fix anything.',
        leave: 'the one stage worth your energy.'
    },
    {
        part: 'Part 1',
        time: '25 minutes',
        title: 'Direction',
        text: 'The Messy Middle Triangle (security, growth, autonomy), your real non-negotiables, and 2–3 role hypotheses tested against live job postings.',
        leave: 'one direction worth your next four weeks.'
    },
    {
        part: 'Part 2',
        time: '25 minutes',
        title: 'Positioning',
        text: 'Three proof stories, the thread that runs through a messy career, and a one-liner you test out loud.',
        leave: 'why you, in one breath.'
    },
    {
        part: 'Part 3',
        time: '20 minutes',
        title: 'Routes in',
        text: 'Ten target companies instead of a hundred postings, a map of the people you already know, and a message to someone on the team that gets replies.',
        leave: 'people to talk to, not queues to join.'
    },
    {
        part: 'Part 4',
        time: '10 minutes',
        title: 'Your two-week reset',
        text: 'Fewer applications, better aimed, through a person wherever you can. A week-by-week checklist, then you redo your Part 0 numbers.',
        leave: 'proof of what moved.'
    }
];

const faqs = [
    {
        q: 'How long does it take?',
        a: ['About 90 minutes. Do it in one sitting or three, your call.']
    },
    {
        q: "I'm employed, just restless. Is this for me?",
        a: [
            "Yes, especially Part 1. The Triangle helps you work out what's missing before you start applying for more of the same."
        ]
    },
    {
        q: 'Do I need to use AI?',
        a: [
            'No. The worksheet is pen and brain. The CV Reset Kit that comes with the session has prompts that work in Claude, ChatGPT or any AI assistant, if you want them.'
        ]
    },
    {
        q: 'When is the session?',
        a: [
            'You book a time that suits you within 2 weeks of buying. Fill in Parts 0–3 of the worksheet first, so we can go straight to the hard part.'
        ]
    },
    {
        q: "What if it's not for me?",
        a: [
            'The Next Move Playbook: a full refund within 14 days, no questions asked.',
            'The Bold Move Session: a full refund if you cancel up to 48 hours before your session, and one free reschedule.'
        ]
    }
];
---

<BaseLayout title={title} description={description}>
    <Fragment slot="head">
        <link rel="canonical" href={pageUrl} />

        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={pageUrl} />
        <meta property="og:image" content={ogImageUrl} />
        <meta
            property="og:image:alt"
            content="Kate Mas standing against a warm ochre backdrop in a yellow striped shirt and jeans"
        />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageUrl} />
    </Fragment>

    <div class="next-move">
        <!-- 2. Hero -->
        <section class="hero">
            <div class="wrap hero-grid">
                <div class="hero-text">
                    <p class="hero-kicker">
                        For senior tech people in the messy middle
                    </p>
                    <h1>
                        <span class="h1-main"
                            >Stop applying<br />everywhere.</span
                        >
                        <span class="h1-accent">Start aiming.</span>
                    </h1>
                    <p class="hero-lede">
                        Get interviews for roles that fit. The Next Move
                        Playbook is a 90-minute worksheet for senior tech people
                        who've rewritten their CV more times than they'd admit
                        and still hear nothing back.
                    </p>
                    <div class="btn-row">
                        <a href="#offer" class="btn btn-solid btn-hero"
                            >Get the Playbook · €29&nbsp;→</a
                        >
                    </div>
                </div>
                <div class="hero-media">
                    <Image
                        src={heroImg}
                        alt="Kate Mas standing against a warm ochre backdrop in a yellow striped shirt and jeans"
                        format="webp"
                        loading="eager"
                        fetchpriority="high"
                        class="hero-img"
                    />
                </div>
            </div>
        </section>

        <!-- 3. Sound familiar -->
        <section class="section on-blue" aria-labelledby="familiar-title">
            <div class="wrap">
                <p class="kicker">Sound familiar?</p>
                <h2 id="familiar-title">What I kept hearing.</h2>
                <p class="section-intro">
                    I asked experienced tech people what they needed help with
                    in their job search. The same stories came up again and
                    again.
                </p>
                <ul class="familiar-grid" role="list">
                    {familiar.map((line) => <li class="familiar-card">
                        {line}
                    </li>)}
                </ul>
            </div>
        </section>

        <!-- 4. Reframe -->
        <section class="section" aria-labelledby="reframe-title">
            <div class="wrap">
                <p class="kicker">The thing nobody tells you</p>
                <h2 id="reframe-title">The CV is rarely the problem.</h2>
                <p class="lead">
                    Most of the people I spoke to thought they needed a better
                    CV. When we dug in, it was almost never what was broken.
                    Three things were, and they come in this order:
                </p>
                <ol class="reframe-grid" role="list">
                    {reframe.map((item) => <li class="reframe-card">
                        <span class="reframe-num" aria-hidden="true">
                            {item.num}
                        </span>
                        <h3>{item.title}</h3>
                        <p>{item.text}</p>
                    </li>)}
                </ol>
                <blockquote class="pull-quote">
                    A beautiful CV aimed at the wrong roles, through the busiest
                    channel, is still a CV nobody reads.
                </blockquote>
            </div>
        </section>

        <!-- 5. Specialist panel -->
        <section class="section section-tight" aria-labelledby="spec-title">
            <div class="wrap">
                <div class="sky-panel">
                    <h2 id="spec-title">
                        Ten years of expertise. Somehow that's the problem?
                    </h2>
                    <p>
                        Being very good at one thing for a long time does
                        something sneaky. It makes it hard to see what else you
                        are, let alone say it. Your job title starts doing your
                        thinking for you.
                    </p>
                    <p>
                        The Playbook helps you dig your value out from under the
                        title, then aim it somewhere it'll land.
                    </p>
                </div>
            </div>
        </section>

        <!-- 6. What's inside -->
        <section class="section" aria-labelledby="inside-title">
            <div class="wrap">
                <p class="kicker">What's inside</p>
                <h2 id="inside-title">
                    90 minutes. Five parts. A plan you can start on Monday.
                </h2>
                <ol class="rows" role="list">
                    {parts.map((p) => <li class="row part-row">
                        <div class="part-meta">
                            <span class="part-num">{p.part}</span>
                            <span class="part-time">{p.time}</span>
                        </div>
                        <div class="part-body">
                            <h3>{p.title}</h3>
                            <p>{p.text}</p>
                        </div>
                        <p class="part-leave">
                            <strong>You leave with:</strong>{' '}
                            {p.leave}
                        </p>
                    </li>)}
                </ol>
            </div>
        </section>

        <!-- 7. Offer -->
        <section id="offer" class="section" aria-labelledby="offer-title">
            <div class="wrap">
                <p class="kicker">Black Friday week · 20–30 November</p>
                <h2 id="offer-title">Two ways in.</h2>
                <div class="offer-grid">
                    <article class="offer-card offer-a">
                        <h3>The Next Move Playbook</h3>
                        <p class="offer-sub">
                            Do it on your own, at your own pace.
                        </p>
                        <p class="price">€29</p>
                        <ul class="offer-list">
                            <li>The 30-page Next Move Playbook worksheet</li>
                            <li>About 90 minutes, in one sitting or three</li>
                            <li>Fill it in on screen or print it out</li>
                            <li>
                                Yours to keep, with any future updates, and to
                                redo next time you're at a crossroads
                            </li>
                        </ul>
                        <a href={PLAYBOOK_URL} class="btn btn-solid btn-block"
                            >Get the Playbook · €29</a
                        >
                    </article>

                    <article class="offer-card offer-b">
                        <div class="offer-head">
                            <h3>The Bold Move Session</h3>
                            <span class="badge">Only 5 spots</span>
                        </div>
                        <p class="offer-sub">
                            For when your pace doesn't allow second-guessing.
                        </p>
                        <p class="price">
                            €150 <span class="price-was">instead of €180</span>
                        </p>
                        <ul class="offer-list">
                            <li>The 30-page Next Move Playbook worksheet</li>
                            <li>
                                A 70-minute 1:1 with me. You fill in Parts 0–3
                                first, so we spend our time on what you found,
                                not on filling in boxes.
                            </li>
                            <li>
                                We pressure-test your direction, sharpen your
                                one-liner, and pick your first 10 targets and
                                the exact messages to send
                            </li>
                            <li>
                                <strong>Bonus: the CV Reset Kit.</strong> Six AI
                                prompts, including a CV Checker, that sharpen
                                your CV without making it sound like everyone
                                else's
                            </li>
                        </ul>
                        <a href={SESSION_URL} class="btn btn-light btn-block"
                            >Book your spot · €150</a
                        >
                    </article>
                </div>
            </div>
        </section>

        <!-- 8. For / not for -->
        <section class="section section-tight" aria-label="Who this is for">
            <div class="wrap fit-grid">
                <div>
                    <h2 class="fit-title">This is for you if…</h2>
                    <ul class="fit-list">
                        <li>
                            You've got 8–15+ years in product, design, content,
                            research, engineering or product management
                        </li>
                        <li>
                            You're applying and hearing nothing back, or you're
                            about to start and want to do it differently
                        </li>
                        <li>
                            Your career is a bit of a zigzag and you're not sure
                            how to tell it
                        </li>
                        <li>You'd rather aim better than apply more</li>
                    </ul>
                </div>
                <div>
                    <h2 class="fit-title">It's not for you if…</h2>
                    <ul class="fit-list">
                        <li>You want someone to rewrite your CV for you</li>
                        <li>
                            You're early in your career (under about 5 years)
                        </li>
                        <li>
                            You're after a guaranteed job in 30 days. Nobody
                            honest can promise you that.
                        </li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- 9. Stance -->
        <section class="section on-blue" aria-labelledby="stance-title">
            <div class="wrap">
                <h2 id="stance-title">One CV per direction. Not per job.</h2>
                <p class="lead">
                    I'm not going to teach you to rewrite your CV for every
                    posting. It's busywork that feels like progress, and it
                    slowly turns your CV into keyword soup that doesn't sound
                    like anyone. A strong CV for a clear target already fits
                    most roles in that target.
                </p>
                <p class="stance-line">
                    If you're editing your CV for every application, the problem
                    isn't your CV. It's your aim.
                </p>
            </div>
        </section>

        <!-- 10. About -->
        <section class="section" aria-labelledby="about-title">
            <div class="wrap about">
                <Image
                    src={aboutImg}
                    alt="Kate Mas, sitting cross-legged on a chair in a yellow striped shirt"
                    format="webp"
                    loading="lazy"
                    class="about-img"
                />
                <div class="about-text">
                    <p class="kicker">Who's behind this</p>
                    <h2 id="about-title">Hi, I'm Kate.</h2>
                    <p>
                        I'm a career coach for people who didn't follow the
                        plan, because there was never a plan, and that's okay. I
                        help experienced tech people get clear on what they want
                        and figure out what comes next.
                    </p>
                    <p>
                        I spent over 8 years working in tech, building teams and
                        leading UX writing and content functions at companies
                        like Preply and Qonto. Along the way, I've hired and
                        worked with senior professionals across different
                        disciplines – from design and product to content and
                        localization. I've seen careers evolve from both sides
                        of the hiring table: as someone building teams and as
                        someone helping people navigate their next career move.
                    </p>
                    <a href="/about" class="about-link">
                        More about me
                        <svg
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            aria-hidden="true"
                        >
                            <path d="M5 12h14M12 5l7 7-7 7" />
                        </svg>
                    </a>
                </div>
            </div>
        </section>

        <!-- 11. FAQ -->
        <section class="section" aria-labelledby="faq-title">
            <div class="wrap">
                <h2 id="faq-title">Questions</h2>
                <ul class="rows" role="list">
                    {faqs.map((f) => <li class="row faq-row">
                        <h3>{f.q}</h3>
                        {f.a.map((para) => <p>{para}</p>)}
                    </li>)}
                </ul>
            </div>
        </section>

        <!-- 12. Final CTA -->
        <section class="section section-tight" aria-labelledby="cta-title">
            <div class="wrap">
                <div class="cta-panel">
                    <h2 id="cta-title">Stop spinning. Start aiming.</h2>
                    <p>
                        5 session spots this round. Black Friday week ends 30
                        November.
                    </p>
                    <div class="btn-row btn-row-center">
                        <a href={PLAYBOOK_URL} class="btn btn-light"
                            >Get the Playbook · €29</a
                        >
                        <a href={SESSION_URL} class="btn btn-ghost-light"
                            >Book the Bold Move Session · €150</a
                        >
                    </div>
                </div>
            </div>
        </section>
    </div>
</BaseLayout>

<style is:global>
    :root {
        --blue: #1023ce;
        --navy: #0a1890;
        --cream: #fffde9;
        --sky: #86affa;
        --muted: #3a47b8;
        --on-blue-muted: #dce6fe;
        --on-blue-soft: #c9d8fd;
        --white: #ffffff;

        /* Matches the site's --font-serif / --font-sans / --font-accent */
        --font-display: 'Dela Gothic One', sans-serif;
        --font-body: 'Plus Jakarta Sans', sans-serif;
        --font-accent: 'Playfair Display', serif;
    }

    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        margin: 0;
        background: var(--cream);
        color: var(--blue);
        font-family: var(--font-body);
        font-size: 16px;
        line-height: 1.625;
        -webkit-font-smoothing: antialiased;
    }

    h1,
    h2,
    h3,
    p,
    ul,
    ol,
    blockquote {
        margin: 0;
    }

    img {
        display: block;
        max-width: 100%;
    }

    a {
        color: inherit;
    }

    :focus-visible {
        outline: 3px solid var(--sky);
        outline-offset: 3px;
    }

    @media (prefers-reduced-motion: reduce) {
        html {
            scroll-behavior: auto;
        }
    }
</style>

<style>
    .wrap {
        max-width: calc(1120px + 48px);
        margin: 0 auto;
        padding: 0 24px;
    }

    /* Type — mirrors the site scale:
       h2 = text-3xl / sm:text-4xl / md:text-5xl, kicker = text-xs bold
       uppercase tracking-wider, lead = text-base / sm:text-lg / md:text-xl */
    h2 {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: 30px;
        line-height: 1.15;
        margin-bottom: 24px;
    }

    .kicker {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 16px;
    }

    .lead,
    .section-intro,
    .hero-lede,
    .sky-panel p,
    .cta-panel p {
        font-size: 16px;
        line-height: 1.625;
    }

    .lead {
        max-width: 760px;
    }

    @media (min-width: 640px) {
        h2 {
            font-size: 36px;
        }
        .lead,
        .section-intro,
        .hero-lede,
        .sky-panel p,
        .cta-panel p {
            font-size: 18px;
        }
    }

    @media (min-width: 768px) {
        h2 {
            font-size: 48px;
            line-height: 1.1;
        }
        .lead,
        .section-intro,
        .hero-lede,
        .sky-panel p,
        .cta-panel p {
            font-size: 20px;
        }
    }

    /* Card / row headings — the site uses Dela Gothic at text-xl */
    .reframe-card h3,
    .part-body h3 {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: 20px;
        line-height: 1.25;
    }

    /* Buttons */
    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        border-radius: 999px;
        border: 2px solid transparent;
        font-family: var(--font-body);
        font-size: 16px;
        font-weight: 700;
        text-decoration: none;
        padding: 16px 40px;
        line-height: 1.2;
        transition:
            background-color 0.15s,
            color 0.15s,
            border-color 0.15s;
    }

    .btn-solid {
        background: var(--blue);
        color: var(--white);
    }
    .btn-solid:hover {
        background: var(--navy);
    }

    .btn-ghost {
        background: transparent;
        border-color: var(--blue);
        color: var(--blue);
    }
    .btn-ghost:hover {
        border-color: var(--navy);
        color: var(--navy);
    }

    .btn-light {
        background: var(--white);
        color: var(--blue);
    }
    .btn-light:hover {
        background: var(--on-blue-muted);
        color: var(--navy);
    }

    .btn-ghost-light {
        border-color: var(--white);
        color: var(--white);
    }
    .btn-ghost-light:hover {
        background: var(--white);
        color: var(--blue);
    }

    .btn-block {
        display: flex;
        width: 100%;
    }

    .btn-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px 16px;
    }

    .btn-row-center {
        justify-content: center;
    }

    /* Header is the site-wide fixed one from BaseLayout */
    #offer {
        scroll-margin-top: 88px;
    }

    /* 2. Hero */
    .hero {
        padding: 24px 0 96px;
    }

    .hero-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 56px;
        align-items: center;
    }

    .hero-kicker {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--blue);
        margin-bottom: 24px;
    }

    h1 {
        margin-bottom: 24px;
    }

    /* Homepage h1: text-3xl / sm:text-4xl / md:text-5xl, leading 1.05,
       with the accent line at the same size */
    .h1-main,
    .h1-accent {
        display: block;
        font-size: 30px;
        line-height: 1.05;
    }

    .h1-main {
        font-family: var(--font-display);
        font-weight: 400;
    }

    .h1-accent {
        margin-top: 8px;
        font-family: var(--font-accent);
        font-style: italic;
        font-weight: 400;
    }

    @media (min-width: 640px) {
        .h1-main,
        .h1-accent {
            font-size: 36px;
        }
    }

    @media (min-width: 768px) {
        .h1-main,
        .h1-accent {
            font-size: 48px;
        }
    }

    .hero-lede {
        color: var(--muted);
        max-width: 560px;
        margin-bottom: 32px;
    }

    .hero-img {
        width: 100%;
        height: 685px;
        object-fit: cover;
        object-position: 50% 30%;
        border-radius: 0;
    }

    @media (max-width: 700px) {
        .hero-grid {
            grid-template-columns: 1fr;
            gap: 40px;
        }
        .hero-img {
            height: min(685px, 135vw);
        }
        .hero {
            padding-bottom: 64px;
        }
        .hero .btn {
            font-size: 15px;
            padding: 16px 20px;
        }
    }

    /* Sections */
    .section {
        padding: 96px 0;
    }

    .section-tight {
        padding: 48px 0;
    }

    @media (max-width: 700px) {
        .section {
            padding: 64px 0;
        }
        .section-tight {
            padding: 32px 0;
        }
    }

    .on-blue {
        background: var(--blue);
        color: var(--white);
    }
    .on-blue .kicker {
        color: var(--sky);
    }
    .on-blue .lead,
    .on-blue .section-intro {
        color: var(--on-blue-muted);
    }

    /* 3. Sound familiar */
    .section-intro {
        max-width: 720px;
        margin-bottom: 48px;
    }

    .familiar-grid {
        list-style: none;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
        gap: 20px;
    }

    .familiar-card {
        border: 2px solid var(--sky);
        border-radius: 20px;
        padding: 28px;
